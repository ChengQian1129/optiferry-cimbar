diff --git a/src/lib/gui/window_glfw.h b/src/lib/gui/window_glfw.h
index 01bcd2f..d345e88 100644
--- a/src/lib/gui/window_glfw.h
+++ b/src/lib/gui/window_glfw.h
@@ -33,6 +33,12 @@ public:
 #ifdef CIMBAR_USE_ANGLE
 		glfwWindowHint(GLFW_CLIENT_API, GLFW_OPENGL_ES_API);
 		glfwWindowHint(GLFW_CONTEXT_CREATION_API, GLFW_EGL_CONTEXT_API);
 		glfwWindowHint(GLFW_CONTEXT_VERSION_MAJOR, 3);
 		glfwWindowHint(GLFW_CONTEXT_VERSION_MINOR, 0);
+#else
+		// WSLg exposes a modern desktop OpenGL context. Request it explicitly so
+		// the Linux sender does not fall back to an incompatible legacy default.
+		glfwWindowHint(GLFW_CONTEXT_VERSION_MAJOR, 3);
+		glfwWindowHint(GLFW_CONTEXT_VERSION_MINOR, 3);
+		glfwWindowHint(GLFW_OPENGL_PROFILE, GLFW_OPENGL_CORE_PROFILE);
 #endif
